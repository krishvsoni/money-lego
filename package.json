{
  "name": "money-lego",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "smoke": "bun scripts/smoke.ts",
    "db:seed": "bun --conditions=react-server scripts/seed-templates.ts",
    "thumbnails": "bun scripts/thumbnails.ts",
    "test:db": "TEST_MONGODB_URI=\"mongodb://localhost:27017/?replicaSet=rs0&directConnection=true\" vitest run tests/templates-db.test.ts tests/connections-db.test.ts",
    "keys:rotate": "bun --conditions=react-server scripts/rotate-credential-keys.ts",
    "telegram:webhook": "bun --conditions=react-server scripts/telegram-webhook.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/web3.js": "^1.99.0",
    "@xyflow/react": "^12.12.0",
    "bs58": "^6.0.0",
    "lucide-react": "^1.61.0",
    "mongodb": "^7.7.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tweetnacl": "^1.0.3",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
