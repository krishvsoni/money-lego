# ---------- Runtime ----------
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=money_lego
# Protects /api/cron/workflows (schedules, approval expiry, payout re-checks). openssl rand -hex 24
CRON_SECRET=
# Envelope encryption for connector secrets: "<id>:<32 bytes base64>", newest first. openssl rand -base64 32
CREDENTIALS_KEYRING=
CREDENTIALS_KEYRING_FILE=
CLIENT_IP_HEADER=

# ---------- Auth (Clerk) ----------
# `npx clerk@latest init` / `env pull` writes these for the linked Clerk app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workflows
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/workflows
# Production Clerk instances only: https://clerk.<your-domain> (allowed by the CSP).
CLERK_FRONTEND_API_URL=

# ---------- PayPal (sandbox) — server only ----------
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Printed by `npm run paypal:webhook` once APP_URL is public https.
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox

# ---------- AI (OpenRouter, OpenAI-compatible) — server only ----------
OPENROUTER_API_KEY=
# Optional: up to nine comma-separated models, tried in groups of three.
OPENROUTER_MODELS=

# ---------- Partner tools (optional) ----------
# Channel3 product data (Shop AI page + Channel3 block). channel3.ai/docs
CHANNEL3_API_KEY=
# Elastic Cloud / Elasticsearch: run + failure search, AI explanations cite similar failures.
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=money-lego-runs

# ---------- Connector OAuth apps (optional) ----------
# Redirect URI for each: <APP_URL>/api/connections/<slug>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
