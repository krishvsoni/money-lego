APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=money_lego

SESSION_TTL_HOURS=72

MULTIHOPPER_ENV=devnet
MULTIHOPPER_API_KEY=
MULTIHOPPER_WEBHOOK_SECRET=
MULTIHOPPER_ALLOW_PRODUCTION=false
CRON_SECRET=
CREDENTIALS_KEY=
# Envelope-encryption keyring for connection tokens: "<id>:<32 bytes base64>", newest first.
# Prefer CREDENTIALS_KEYRING_FILE pointing at a mounted secret. Generate: openssl rand -base64 32
CREDENTIALS_KEYRING=
CREDENTIALS_KEYRING_FILE=

SOLANA_RPC_URL=
CLIENT_IP_HEADER=

NEXT_PUBLIC_SOLANA_NETWORK=devnet

# OAuth apps identifying Money Lego. Redirect URI for each: <APP_URL>/api/connections/<slug>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
