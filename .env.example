# ---------- Runtime ----------
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=money_lego
# Protects /api/cron/workflows (schedules, approval expiry, payout re-checks). openssl rand -hex 24
CRON_SECRET=
# Dev server runs the heartbeat itself (instrumentation.ts). true = also in production (self-hosted, single instance); false = off.
INTERNAL_CRON=
# Envelope encryption for connector secrets: "<id>:<32 bytes base64>", newest first. openssl rand -base64 32
CREDENTIALS_KEYRING=
CREDENTIALS_KEYRING_FILE=
CLIENT_IP_HEADER=

# ---------- Auth (Kinde) ----------
# Kinde dashboard > your Back-end web application > App keys. Without all four, sign-in falls
# back to Money Lego's own email + password accounts. Full setup: docs/auth.md.
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
# https://<your-business>.kinde.com
KINDE_ISSUER_URL=
# This app's public URL. Kinde's callback is <KINDE_SITE_URL>/api/auth/kinde_callback.
KINDE_SITE_URL=http://localhost:3000
# A path, so it passes the allow-list below.
KINDE_POST_LOGIN_REDIRECT_URL=/workflows
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
# Belt and braces: the app already refuses any post-login redirect that isn't a path on this site.
KINDE_POST_LOGIN_ALLOWED_URL_REGEX=^/

# ---------- PayPal (sandbox) — server only ----------
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Printed by `npm run paypal:webhook` once APP_URL is public https.
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox
# Money Lego account id(s) (comma-separated) that own this PayPal app. Only they see the whole
# PayPal account (all invoices, transactions); every other account sees only its own objects.
PAYPAL_ACCOUNT_OWNER_IDS=

# ---------- AI — server only ----------
# Main agents (Sage, the Money Lego assistant + its PayPal sub-agent, AG Studio's dashboard agents) run on OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Fallback for small tasks when OpenRouter is busy.
OPENAI_SMALL_MODEL=gpt-5.4-mini
# Small, bounded tasks (AI review / write / pick, run explanations) run on OpenRouter.
OPENROUTER_API_KEY=
# Optional: up to nine comma-separated models, tried in groups of three.
OPENROUTER_MODELS=

# ---------- Partner tools (optional) ----------
# AG Studio licence (ag-grid.com/studio, 45-day trial). Without it the dashboard shows trial watermarks;
# the AI dashboard assistant needs the STUDIO-PRO-AI tier. Public by design (sent to the browser).
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
# Channel3 product data (Shop AI page + Channel3 block). channel3.ai/docs
CHANNEL3_API_KEY=
# Elastic Cloud / Elasticsearch: run + failure search, AI explanations cite similar failures.
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=money-lego-runs

# ---------- Connector OAuth apps (optional) ----------
# Redirect URI for each: <APP_URL>/api/connections/<slug>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
# Slack app → Basic Information → Signing Secret. Verifies the Slack mention trigger's events
# (Event Subscriptions Request URL: <APP_URL>/api/integrations/slack).
SLACK_SIGNING_SECRET=
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
